---
import { getCollection } from 'astro:content';
import NotesIndex from '../../../components/notes/NotesIndex.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isPublished } from '../../../lib/i18n';
import { notesIndexSchema } from '../../../lib/schema';
const notes = (await getCollection('notes', isPublished))
  .filter((note) => note.data.lang === 'fr')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout lang="fr" title="Notes" description="Notes techniques, journaux de développement et expérimentations autour du développement logiciel, de l’architecture web, de l’infrastructure et de l’open source." canonicalPath="/fr/notes/" enPath="/notes/" frPath="/fr/notes/" alternates={[{ lang: 'en', path: '/notes/' }, { lang: 'fr', path: '/fr/notes/' }, { lang: 'x-default', path: '/notes/' }]} schema={notesIndexSchema('fr', notes)}>
  <NotesIndex lang="fr" {notes} />
</BaseLayout>
