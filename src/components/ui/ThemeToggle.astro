<button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
  <svg class="sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
  <svg class="moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 15.3A8.5 8.5 0 0 1 8.7 4a8.5 8.5 0 1 0 11.3 11.3Z"/></svg>
</button>

<style>
  .theme-toggle { display: grid; width: 2rem; height: 2rem; place-items: center; border: 0; border-radius: .35rem; background: transparent; color: var(--muted); cursor: pointer; transition: color 150ms, background 150ms; }
  .theme-toggle:hover { background: var(--surface); color: var(--accent); }
  svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.7; }
  .moon { display: none; }
  :global(html.dark) .sun { display: none; }
  :global(html.dark) .moon { display: block; }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
