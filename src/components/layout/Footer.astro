---
import { socials } from '../../data/socials';
import type { Lang } from '../../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="mx-auto w-full max-w-[960px] px-5 pb-10 sm:px-7 sm:pb-14">
  <div class="footer-rule" aria-hidden="true"><span></span></div>
  <div class="pt-10 sm:grid sm:grid-cols-[1fr_auto] sm:gap-10">
    <div>
    <p class="display m-0 text-lg font-semibold tracking-[-0.03em]">Johan Ledoux</p>
    <p class="mt-1 font-mono text-[.74rem] text-muted">Fullstack Product Engineer</p>
    <p class="mt-4 max-w-[34rem] text-sm text-muted">
      {lang === 'fr'
        ? "Fullstack Product Engineer spécialisé dans la conception de logiciels, d'outils pour développeurs et d'infrastructures."
        : 'Fullstack Product Engineer building software, developer tools and infrastructure.'}
    </p>
    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
      {socials.map((social) => <a class="text-link" href={social.href} rel="me">{social.label} <span aria-hidden="true">↗</span></a>)}
      <a class="text-link" href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
    </div>
    </div>
    <p class="meta mt-8 sm:mt-1 sm:text-right">
      {lang === 'fr' ? 'Construit avec Astro et Tailwind CSS.' : 'Built with Astro and Tailwind CSS.'}<br />
      {lang === 'fr' ? 'Données structurées avec ' : 'Structured with '}
      <a href="https://unschema-graph.jhdx.dev/">@unschema-graph/astro</a>.
    </p>
  </div>
</footer>

<style>
  .footer-rule { height: 1px; background: var(--border-strong); }
  .footer-rule span { display: block; width: 5rem; height: 2px; background: var(--accent); transform: translateY(-.5px); }
</style>
