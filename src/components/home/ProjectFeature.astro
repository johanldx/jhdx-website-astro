---
import type { Project } from '../../data/projects';
import type { Lang } from '../../data/site';
import { formatDate } from '../../lib/i18n';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  project: Project;
  lang: Lang;
  metadata: {
    stars: number | null;
    version: string | null;
    releaseDate: string | null;
  };
}
const { project, lang, metadata } = Astro.props;
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <SectionHeader id="projects-title" title="Open source" />
  <article class="project-card">
    <div class="project-heading">
      <div>
        <h3 class="display m-0 text-[1.75rem] leading-none font-bold tracking-[-0.045em]">{project.name}</h3>
        <p class="mt-5 max-w-[42rem] text-[1.06rem] leading-relaxed">{project.description[lang]}</p>
      </div>
      <span class="signal" aria-label="Featured open-source project">{lang === 'fr' ? 'maintenu' : 'maintained'}</span>
    </div>
    <p class="mt-4 max-w-[42rem] text-[.94rem] text-muted">{project.longDescription[lang]}</p>
    <ul class="meta mt-5 flex flex-wrap gap-x-4 gap-y-1" aria-label={lang === 'fr' ? 'Technologies' : 'Technologies'}>
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="meta metadata mt-6 flex flex-wrap gap-x-6 gap-y-2 border-y border-border py-3">
      {metadata.stars !== null && <span>★ {metadata.stars}</span>}
      {metadata.version && <span>npm v{metadata.version}</span>}
      {metadata.releaseDate && <span>{lang === 'fr' ? 'publié le' : 'released'} {formatDate(new Date(metadata.releaseDate), lang)}</span>}
    </div>
    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <a class="primary-link" href={project.links.docs}>{lang === 'fr' ? 'Documentation' : 'Documentation'} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={project.links.github}>GitHub <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={project.links.npm}>npm <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</section>

<style>
  .project-card { position: relative; overflow: hidden; border: 1px solid var(--border-strong); border-radius: .7rem; background: var(--surface); padding: 2.1rem; transition: border-color 180ms, transform 180ms; }
  section { border-top: 1px solid var(--border); }
  .project-card::before { position: absolute; top: 0; bottom: 0; left: 0; width: 4px; background: var(--accent); content: ''; }
  .project-card:hover { border-color: var(--accent-border); transform: translateY(-1px); }
  .project-heading { display: grid; grid-template-columns: 1fr auto; gap: 1.25rem; align-items: start; }
  .signal { margin-top: .05rem; border: 1px solid var(--accent-border); border-radius: 999px; background: var(--accent-soft); padding: .25rem .58rem; color: var(--accent-muted); font: 700 .66rem/1.4 var(--font-mono); }
  .signal::before { content: ''; display: inline-block; width: .38rem; height: .38rem; margin-right: .35rem; border-radius: 50%; background: var(--accent); vertical-align: .05rem; }
  .metadata { color: var(--accent-muted); }
  .primary-link { font-weight: 700; color: var(--accent-muted); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  ul { list-style: none; padding: 0; }
  @media (max-width: 480px) { .project-card { padding: 1.5rem; } .project-heading { grid-template-columns: 1fr; } .signal { width: fit-content; } }
</style>
