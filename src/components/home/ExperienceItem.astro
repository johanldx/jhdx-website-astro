---
interface Props {
  role?: string;
  company: string;
  start: string;
  end: string;
  description: string;
  logo?: string;
  href?: string;
  secondaryDescription?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto' | 'low';
}
const {
  role,
  company,
  start,
  end,
  description,
  logo,
  href,
  secondaryDescription,
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;
---

<article class="experience">
  {logo && <div class="logo-slot" aria-hidden="true"><img src={logo} alt="" width="36" height="36" loading={loading} fetchpriority={fetchpriority} decoding="async" /></div>}
  <div class:list={["experience-content", !logo && "without-logo"]}>
    <div class="sm:grid sm:grid-cols-[1fr_auto] sm:gap-5">
      <div>
        {role && <p class="display m-0 text-[1.03rem] font-semibold tracking-[-0.025em]">{role}</p>}
        <h3 class:list={["mt-0.5 text-[.88rem] text-muted", !role && "display text-[1.03rem] font-semibold text-foreground"]}>
          {href ? <a class="text-link" href={href}>{company} <span aria-hidden="true">↗</span></a> : company}
        </h3>
      </div>
      <p class="meta date mt-1 sm:mt-0">{start}—{end}</p>
    </div>
    <p class="mt-3 max-w-[44rem] text-[.94rem] text-muted">{description}</p>
    {secondaryDescription && <p class="mt-2 max-w-[39rem] text-[.88rem] text-muted">{secondaryDescription}</p>}
  </div>
</article>

<style>
  .experience { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: .9rem; position: relative; }
  .logo-slot { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; }
  .logo-slot img { width: 2rem; height: 2rem; border-radius: 4px; object-fit: contain; }
  .experience-content.without-logo { grid-column: 1 / -1; }
  .experience + .experience { margin-top: 2.4rem; padding-top: 2.4rem; border-top: 1px dashed var(--border); }
  .date { color: var(--accent-muted); }
  :global(html.dark) .logo-slot img { background: #fff; }
</style>
