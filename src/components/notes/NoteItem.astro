---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../data/site';
import { formatDate, notePath } from '../../lib/i18n';

interface Props {
  note: CollectionEntry<'notes'>;
  lang: Lang;
}
const { note, lang } = Astro.props;
---

<article class="note-item">
  <p class="meta note-date"><time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt, lang)}</time> <span aria-hidden="true">·</span> {note.data.lang}</p>
  <h2 class="display mt-3 text-[1.28rem] leading-snug font-semibold tracking-[-0.03em]">
    <a href={notePath(note)}>{note.data.title} <span aria-hidden="true">↗</span></a>
  </h2>
  <p class="mt-3 max-w-[43rem] text-[.94rem] text-muted">{note.data.description}</p>
  <p class="meta mt-4 uppercase">{note.data.type}{note.data.tags.slice(0, 3).map((tag) => <span> <span aria-hidden="true">·</span> {tag}</span>)}</p>
</article>

<style>
  .note-item { position: relative; padding-right: 1rem; }
  .note-item + .note-item { margin-top: 2.25rem; padding-top: 2.25rem; border-top: 1px solid var(--border); }
  .note-date { color: var(--accent-muted); text-transform: uppercase; }
  h2 { margin-bottom: 0; }
  h2 a { text-decoration: none; }
  h2 span { display: inline-block; color: var(--accent); font-family: var(--font-sans); font-size: .82em; transition: transform 160ms; }
  h2 a:hover span { transform: translate(2px, -1px); }
</style>
